# cp .env.example .env && chmod 600 .env && nano .env   (no subir .env a GitHub ni a S3)

# IP privada de VM3 (output Vm3PrivateIp)
DB_HOST=10.20.20.X
# Las mismas contraseñas de aplicación que generó VM3 (./generar_env.sh allí)
MYSQL_PASSWORD=REEMPLAZAR
POSTGRES_PASSWORD=REEMPLAZAR
MONGO_PASSWORD=REEMPLAZAR

# Bucket del data lake (output DataLakeBucketName)
S3_BUCKET=REEMPLAZAR
AWS_REGION=us-east-1
ATHENA_DATABASE=bodega_h2

# DNS interno del ALB, sin http:// (output InternalAlbDnsName). Solo para la predicción nocturna.
BODEGA_ALB_DNS=internal-bodega-h2-alb-XXXX.us-east-1.elb.amazonaws.com
